class Student:
    def __init__(self, name, matric_no):
        self.name = name
        self.matric_no = matric_no
        self.scores = []

    def add_score(self, score):
        self.scores.append(score)

    def calculate_total(self):
        return sum(self.scores)

    def calculate_average(self):
        if len(self.scores) == 0:
            return 0
        return self.calculate_total() / len(self.scores)


class ResultManagementSystem:
    def __init__(self):
        self.students = []

    def add_student(self, student):
        self.students.append(student)

    def display_results(self):
        for student in self.students:
            print("Name:", student.name)
            print("Matric No:", student.matric_no)
            print("Total Score:", student.calculate_total())
            print("Average Score:", student.calculate_average())
            print("----------------------")


# Main Program
student1 = Student("Air Oluwadamisi Iyinoluwa", "24/13892")
student1.add_score(70)
student1.add_score(80)
student1.add_score(90)

system = ResultManagementSystem()
system.add_student(student1)
system.display_results()
